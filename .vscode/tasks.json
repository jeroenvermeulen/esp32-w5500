{
  // PlatformIO and ESPHome tasks. Run via Terminal > Run Task….
  // PIO tasks require the `pio` CLI on PATH (e.g. `brew install platformio`).
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "PIO: Build",
      "type": "shell",
      "command": "pio run",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ]
      }
    },
    {
      "label": "PIO: Upload",
      "type": "shell",
      "command": "pio run -t upload",
      "group": "build",
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ]
      }
    },
    {
      "label": "PIO: Monitor",
      "type": "shell",
      "command": "pio device monitor",
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "PIO: Upload and Monitor",
      "type": "shell",
      "command": "pio run -t upload -t monitor",
      "group": "build",
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "PIO: Clean",
      "type": "shell",
      "command": "pio run -t clean",
      "problemMatcher": []
    },
    {
      "label": "PIO: Erase Flash",
      "type": "shell",
      "command": "pio run -t erase",
      "problemMatcher": []
    },
    {
      "label": "PIO: List Devices",
      "type": "shell",
      "command": "pio device list",
      "problemMatcher": []
    },
    {
      "label": "PIO: Generate compile_commands.json",
      "detail": "For IntelliSense / clangd",
      "type": "shell",
      "command": "pio run -t compiledb",
      "problemMatcher": []
    },
    {
      "label": "ESPHome: Validate Config",
      "type": "shell",
      "command": "esphome config esp32-w5500.yaml",
      "options": {
        "cwd": "${workspaceFolder}/esphome"
      },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: Build",
      "type": "shell",
      "command": "esphome compile esp32-w5500.yaml",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "options": {
        "cwd": "${workspaceFolder}/esphome"
      },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: Upload",
      "type": "shell",
      "command": "esphome upload esp32-w5500.yaml",
      "options": {
        "cwd": "${workspaceFolder}/esphome"
      },
      "presentation": {
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: Logs",
      "type": "shell",
      "command": "esphome logs esp32-w5500.yaml",
      "options": {
        "cwd": "${workspaceFolder}/esphome"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: Build, Upload and Logs",
      "type": "shell",
      "command": "esphome run esp32-w5500.yaml",
      "options": {
        "cwd": "${workspaceFolder}/esphome"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "ESPHome: Clean",
      "type": "shell",
      "command": "esphome clean esp32-w5500.yaml",
      "options": {
        "cwd": "${workspaceFolder}/esphome"
      },
      "problemMatcher": []
    }
  ]
}
